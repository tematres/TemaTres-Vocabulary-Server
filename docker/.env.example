# Copy to docker/.env and change the password (it is only used when the database is created; change it later in the database as well).
TEMATRES_DB_PASSWORD=change-me
# Port on the host (http://localhost:8080/vocab/). The port is only published on localhost; set TEMATRES_BIND=0.0.0.0 to publish it on the network.
TEMATRES_PORT=8080
#TEMATRES_BIND=127.0.0.1
# PHP version of the image
#PHP_VERSION=8.3
